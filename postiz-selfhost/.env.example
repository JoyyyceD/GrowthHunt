# ── Postiz self-host config ─────────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

# Public URL where Postiz is reachable (the cloud host's domain).
# Local test only: http://localhost:4007
PUBLIC_URL=https://postiz.yourdomain.com

# Random secret — generate with: openssl rand -hex 32
JWT_SECRET=

# ── Database = YOUR Supabase Postgres ────────────────────────────────────────
# Use a DEDICATED Supabase project (not the GrowthHunt one).
# Supabase dashboard → Project Settings → Database → Connection string →
#   pick "Direct connection" (host db.<ref>.supabase.co, port 5432) — Prisma
#   migrations need the direct connection, NOT the 6543 pooler.
#   Append ?sslmode=require (Supabase enforces SSL).
# Format:
#   postgresql://postgres:<DB_PASSWORD>@db.<ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# ── X / Twitter OAuth ────────────────────────────────────────────────────────
# Register an app at developer.x.com (OAuth 1.0a or OAuth2). Postiz uses these
# to run the "Connect X" flow on your behalf. Set the callback URL in the X app
# to:  ${PUBLIC_URL}/integrations/social/x
X_API_KEY=
X_API_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Lock signups after you've created your account:
# DISABLE_REGISTRATION=true
