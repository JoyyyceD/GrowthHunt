# Email
BREVO_API_KEY=""
LISTINGBOTT_NOTIFY_EMAIL="hi@growthhunt.ai"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Anonymous-vote IP hash salt (≥32 chars). Generate with: openssl rand -hex 32
DAILY_SALT_BASE=""

# LemonSqueezy — Xgrower Pro subscription
# Get API key from: Settings → API (https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=""
# Numeric store id from: Settings → Stores
LEMONSQUEEZY_STORE_ID=""
# Variant id of the Xgrower Pro FOUNDING tier ($9/mo, first 500 paid users)
LEMONSQUEEZY_XGROWER_FOUNDING_VARIANT_ID=""
# Variant id of the Xgrower Pro STANDARD tier ($19/mo, user #501+)
LEMONSQUEEZY_XGROWER_STANDARD_VARIANT_ID=""
# Webhook signing secret (set when creating webhook → Settings → Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=""

# MiniMax — LLM for Xgrower AI replies and the GEO audit's First Answer scoring
MINIMAX_API_KEY=""
# Optional override (default: MiniMax-Text-01)
XGROWER_MODEL=""

# GitHub — optional. Raises the Velocity tracker's GitHub Search rate limit.
# Works unauthenticated for the weekly cron; set this for headroom.
# Create a classic token with NO scopes (public data only) at:
# https://github.com/settings/tokens
GITHUB_TOKEN=""

# GEO Phase 2 — live AI citation check. Each engine is optional; missing
# keys render as "skipped" cells in the citation heatmap rather than failing.
PERPLEXITY_API_KEY=""
# Optional model override (default: sonar)
PERPLEXITY_MODEL=""

OPENAI_API_KEY=""
# Optional model override (default: gpt-4o-mini, uses web_search tool via Responses API)
OPENAI_SEARCH_MODEL=""

GEMINI_API_KEY=""
# Optional model override (default: gemini-2.0-flash, uses google_search grounding)
GEMINI_MODEL=""

ANTHROPIC_API_KEY=""
# Optional model override (default: claude-haiku-4-5-20251001, uses web_search tool)
ANTHROPIC_SEARCH_MODEL=""

# GEO Phase 2 — weekly re-audit cron auth. Set this on Vercel and pass it as
# `Authorization: Bearer <secret>` from Vercel Cron. Leave empty in dev.
CRON_SECRET=""
